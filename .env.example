# ==============================================================================
# SIGNATURE AURA DEVELOPERS - ENVIRONMENT CONFIGURATION (VERCEL READY)
# ==============================================================================
# No mandatory environment variables are required to deploy on Vercel.
# Vercel automatically sets VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL.

# Optional: Set your custom canonical domain (e.g. https://signatureaura.com)
NEXT_PUBLIC_SITE_URL="https://signatureaura.com"

# Optional: Runtime app URL override
APP_URL="MY_APP_URL"

# Optional: Required only if enabling server-side Gemini AI routes in the future
GEMINI_API_KEY="MY_GEMINI_API_KEY"
